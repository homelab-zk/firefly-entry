# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- Firefly III ---
# URL of your Firefly III as the container can reach it (LAN address is fine).
FIREFLY_URL=http://192.0.2.10:8080
# The Personal Access Token is read from this file (mounted by docker-compose.yml).
FIREFLY_TOKEN_FILE=/run/secrets/firefly_token

# --- Public address (must match the HTTPS hostname in the browser exactly) ---
RP_ID=entry.example.lan
ORIGIN=https://entry.example.lan

# --- PIN: output of `python3 gen_pin_hash.py` (asks for the PIN, at least 4 digits) ---
PIN_HASH=scrypt:<salt>:<hash>

# --- Receipt reading ---
# cloudflare = Cloudflare Workers AI (fast, free daily allowance; the photo leaves your network)
# ollama     = your own Ollama server (local, slower)
OCR_BACKEND=cloudflare
CF_ACCOUNT_ID=<cloudflare-account-id>
CF_API_TOKEN=<cloudflare-api-token-with-workers-ai-permission>
# CF_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# CF_IMG_SIZE=1280
# CF_TIMEOUT=60

# Ollama: required with OCR_BACKEND=ollama; with cloudflare it is the optional fallback.
# Leave OLLAMA_URL out to run Cloudflare-only.
OLLAMA_URL=http://192.0.2.20:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_IMG_SIZE=768
# 0 = run the model on CPU (slower, but avoids garbage output on small GPUs)
OLLAMA_NUM_GPU=0
# OLLAMA_TIMEOUT=600

# --- Other ---
# Timezone for "today" and for the 12:00 time of backdated entries.
TZ=UTC
# Log out after this many idle seconds.
SESSION_IDLE_SECONDS=180
# Max size of the photo attached in Firefly (bytes).
# MAX_ATTACH_BYTES=1000000
